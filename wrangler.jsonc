{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rngdle-automation",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": "./dist" },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": false,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": true
    }
  },
  "vars": {
    "CONTROL_PUBLIC_URL": "rngdle-automation.blaiser509-d39.workers.dev",
    "CONTROL_SESSION_DAYS": "7",
    "EMAIL_RETRY_MINUTES": "1",
    "LLM_ENDPOINT": "https://api.deepseek.com",
    "LLM_MAX_ATTEMPTS": "3",
    "LLM_MAX_TOKENS": "2048",
    "LLM_MODEL": "deepseek-flash",
    "LLM_THINKING": "disabled",
    "POEM_ENABLED": "false",
    "POEM_RETRY_MINUTES": "5",
    "RETRY_MINUTES": "30",
    "RETURN_LIKES_ENABLED": "false",
    "RETURN_LIKES_LOOKBACK_DAYS": "7",
    "RETURN_LIKES_MAX_PER_DAY": "10",
    "RETURN_LIKES_POLL_MINUTES": "60",
    "SMTP_AUTH_MODE": "password",
    "SMTP_PORT": "587",
    "SMTP_REQUIRE_TLS": "true",
    "SMTP_SECURE": "false"
  },
  "durable_objects": {
    "bindings": [{ "name": "AUTOMATION", "class_name": "Automation" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Automation"] }],
  "env": {
    "staging": {
      "name": "rngdle-automation-staging",
      "routes": [],
      "vars": {
        "CONTROL_PUBLIC_URL": "https://your-worker-name.your-subdomain.workers.dev"
      },
      "durable_objects": {
        "bindings": [{ "name": "AUTOMATION", "class_name": "Automation" }]
      }
    }
  }
}
